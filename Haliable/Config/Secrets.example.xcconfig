// Secrets.example.xcconfig
//
// COPY this file to `Secrets.xcconfig` (same folder) and fill in real values.
// `Secrets.xcconfig` is git-ignored; this example is committed so the required
// keys are documented. It is wired as the app target's base configuration, so
// these flow into the build and (for keys referenced in Info.plist) the bundle.
//
// The `/$()/` is the xcconfig escape so the `//` in a URL is NOT read as a
// comment. ⚠️ A bare `https://host` gets TRUNCATED to `https:` — always write
// URLs as `https:/$()/host`.
//
// ── Required for full functionality ──────────────────────────────────────────
//
// USDA_API_KEY — REQUIRED for the USDA product-lookup tier. There is no demo-key
//   fallback: without it, USDA lookups are disabled and the app uses Open Food
//   Facts only. Free key: https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY = PASTE_YOUR_USDA_KEY_HERE

// SUPABASE_URL + SUPABASE_ANON_KEY — REQUIRED for sign-in, photo reviews, and the
//   Store Atlas (read + submit). Without them those features run in local mock
//   mode; scanning/browsing still work. The ANON key is safe to ship (Row-Level
//   Security protects the data). NEVER put the service_role key here.
SUPABASE_URL = https:/$()/YOUR_REF.supabase.co
SUPABASE_ANON_KEY = eyJhbGciOi...

// ── Optional / unused ────────────────────────────────────────────────────────
//
// HALIABLE_API_BASE — vestigial (the Atlas talks to Supabase directly now). Leave
//   as-is; it is not read by any code path.
HALIABLE_API_BASE = https:/$()/haliable-api.onrender.com
