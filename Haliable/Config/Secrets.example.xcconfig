// Secrets.example.xcconfig
//
// COPY this file to `Secrets.xcconfig` (same folder) and fill in real values.
// Secrets.xcconfig is git-ignored; this example is committed so the keys are documented.
//
// The `/$()/` is the xcconfig escape so the `//` in a URL isn't read as a comment.

// Your Supabase project URL, e.g. https://abcd1234.supabase.co
SUPABASE_URL = https:/$()/YOUR_REF.supabase.co

// The Supabase ANON (public) key — safe to ship; Row-Level Security protects data.
// NEVER put the service_role key here.
SUPABASE_ANON_KEY = eyJhbGciOi...

// (Optional, for the future Atlas backend) the Node API base URL.
HALIABLE_API_BASE = https:/$()/haliable-api.onrender.com

// Your free USDA FoodData Central key (https://api.data.gov/signup/).
USDA_API_KEY = PASTE_YOUR_USDA_KEY_HERE
