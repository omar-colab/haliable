# Netlify Functions env — Sign in with Apple token store + revoke.
# Set these in Netlify → Site settings → Environment variables. NEVER commit real values.
#
# >>> YOU SUPPLY (from your Apple Developer account + Supabase) <<<

# Apple — Certificates, Identifiers & Profiles
APPLE_TEAM_ID=ABCDE12345                 # 10-char Team ID
APPLE_KEY_ID=ABCDE12345                  # Key ID of your Sign in with Apple AuthKey
APPLE_CLIENT_ID=app.haliable.ios            # app Bundle ID used for SIWA
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...AuthKey_XXXX.p8 contents...\n-----END PRIVATE KEY-----"

# Supabase — Project settings → API
SUPABASE_URL=https://YOUR_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...         # service_role key (server-only, bypasses RLS)
