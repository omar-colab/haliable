# Copy to .env (same folder) and paste the real values in. .env is git-ignored.
#   cp .env.example .env && chmod 600 .env
#
# Supabase → Project Settings → API Keys.
SUPABASE_URL=https://abumevloleevhoqxfnoe.supabase.co

# A SECRET key (starts sb_secret_). It bypasses row-level security, which is why
# it lives here and never in the iOS app — the app ships the publishable key.
# Shown once at creation. Lose it and you rotate, you don't recover it.
SUPABASE_SECRET_KEY=
