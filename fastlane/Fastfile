default_platform(:ios)

# All credentials come from environment variables — never commit secrets.
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH  → App Store Connect API key (.p8)
#   APP_IDENTIFIER, APPLE_ID                 → see Appfile

platform :ios do
  desc "Generate App Store screenshots (6.9\" iPhone) via the self-contained UITest"
  lane :screenshots do
    # Self-contained (no `snapshot init` needed). Captures to screens.xcresult,
    # then exports PNGs to ./fastlane/screenshots. No parallel clones: a clone
    # drops `simctl privacy grant camera`, so the camera prompt lands in the shot.
    sh("cd .. && xcodebuild test -scheme Haliable " \
       "-destination 'platform=iOS Simulator,name=iPhone 17 Pro Max' " \
       "-only-testing:HaliableUITests/ScreenshotUITests " \
       "-parallel-testing-enabled NO " \
       "-resultBundlePath fastlane/screens.xcresult CODE_SIGNING_ALLOWED=NO")
    sh("cd .. && rm -rf fastlane/screenshots && " \
       "xcrun xcresulttool export attachments " \
       "--path fastlane/screens.xcresult --output-path fastlane/screenshots")
  end

  desc "Build and upload a TestFlight build"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"],
      in_house: false
    )
    increment_build_number(xcodeproj: "Haliable.xcodeproj")
    build_app(
      scheme: "Haliable",
      export_method: "app-store",
      # HTTPS-only app → encryption is exempt (also set in Info.plist).
      export_options: { uploadBitcode: false }
    )
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
